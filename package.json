{
  "name": "tcgscan-browse",
  "version": "0.9.34",
  "description": "Shared Pokemon TCG card-browse kit for the TCGScan apps: catalog + prices + similarity clients for the tcgscan-data server, the search query grammar, and the CatalogBrowser React Native component.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "check:reset": "tsc && node --import ./scripts/reset-register.mjs scripts/reset-check.mjs",
    "check:theme": "tsc && node scripts/theme-server-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brassmonkey381/tcgscan-browse.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "expo-image": "*",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-image": "~56.0.11",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
